@*
    Vista: Views/Home/Contacto.cshtml
    Controlador: HomeController.Contacto()  →  GET /Home/Contacto
    Descripción: Página de contacto con dos secciones:
                 - Información de contacto (dirección, teléfono, email, horario).
                 - Formulario de mensaje (solo visual, sin acción de envío configurada).
    Modelo: ninguno (contenido estático).
    Acceso: público, no requiere sesión.
*@
@{
    ViewData["Title"] = "Contacto";
}

<style>

body{
    background:#f4fbfd;
}

.pagina-contenido{

    max-width:1300px;

    margin:auto;

    padding:40px 20px 80px;
}

.pagina-contenido h2{

    text-align:center;

    font-size:52px;

    color:#007ea7;

    font-weight:800;

    margin-bottom:15px;
}

.pagina-contenido > p{

    text-align:center;

    color:#666;

    font-size:20px;

    margin-bottom:60px;
}

/* GRID */

.contacto-grid{

    display:grid;

    grid-template-columns:
    1fr 1.1fr;

    gap:35px;
}

/* TARJETAS */

.contacto-info,
.contacto-form{

    background:
    rgba(255,255,255,.75);

    backdrop-filter:
    blur(15px);

    border-radius:30px;

    padding:40px;

    box-shadow:
    0 20px 50px rgba(0,0,0,.07);
}

.contacto-info h3,
.contacto-form h3{

    color:#0099cc;

    font-size:30px;

    margin-bottom:35px;

    font-weight:700;
}

/* ITEMS */

.contacto-item{

    display:flex;

    gap:20px;

    margin-bottom:35px;

    align-items:flex-start;

    transition:.3s;
}

.contacto-item:hover{

    transform:
    translateX(8px);
}

.contacto-icono{

    width:70px;

    height:70px;

    border-radius:20px;

    background:
    linear-gradient(
    135deg,
    #00b4d8,
    #0099cc
    );

    display:flex;

    justify-content:center;

    align-items:center;

    color:white;

    font-size:28px;

    flex-shrink:0;
}

.contacto-item strong{

    color:#0077a6;

    font-size:18px;
}

.contacto-item p{

    margin-top:8px;

    color:#666;
}

/* FORM */

.form-group{

    margin-bottom:22px;
}

.form-group label{

    font-weight:700;

    color:#444;

    margin-bottom:10px;

    display:block;
}

.form-control{

    border:none !important;

    background:#f7fafc !important;

    border-radius:15px !important;

    padding:16px !important;

    box-shadow:
    inset 0 0 0 1px #ddeaf0;

    transition:.3s;
}

.form-control:focus{

    box-shadow:
    0 0 0 4px rgba(0,153,204,.15)
    !important;

    background:white !important;
}

textarea{

    resize:none;
}

/* BOTÓN */

.btn-enviar{

    width:100%;

    border:none;

    background:
    linear-gradient(
    90deg,
    #0099cc,
    #00b4d8
    );

    color:white;

    padding:16px;

    border-radius:50px;

    font-size:18px;

    font-weight:700;

    transition:.3s;
}

.btn-enviar:hover{

    transform:
    translateY(-3px);

    box-shadow:
    0 15px 35px rgba(0,153,204,.25);
}

/* RESPONSIVE */



.contacto-grid{

grid-template-columns:1fr;

}

.pagina-contenido h2{

font-size:38px;

}

}

</style>



<div class="pagina-contenido">

    <h2>
        Contáctanos
    </h2>

    <p>
        Estamos disponibles para resolver tus dudas y agendar tus horas médicas.
    </p>


    <div class="contacto-grid">

        <!-- INFORMACIÓN -->

        <div class="contacto-info">

            <h3>
                Información de contacto
            </h3>


            <div class="contacto-item">

                <span class="contacto-icono">
                    📍
                </span>

                <div>

                    <strong>Dirección</strong>

                    <p>
                        Av. Salud 1234, Puerto Montt
                    </p>

                </div>

            </div>


            <div class="contacto-item">

                <span class="contacto-icono">
                    📞
                </span>

                <div>

                    <strong>Teléfono</strong>

                    <p>
                        +56 65 234 5678
                    </p>

                </div>

            </div>


            <div class="contacto-item">

                <span class="contacto-icono">
                    ✉️
                </span>

                <div>

                    <strong>Email</strong>

                    <p>
                        contacto@clinicasantamaria.cl
                    </p>

                </div>

            </div>


            <div class="contacto-item">

                <span class="contacto-icono">
                    🕐
                </span>

                <div>

                    <strong>Horario</strong>

                    <p>
                        Lunes a Viernes: 8:00 - 20:00
                        <br>
                        Sábado: 9:00 - 14:00
                    </p>

                </div>

            </div>

        </div>


        <!-- FORMULARIO -->

        <div class="contacto-form">

            <h3>
                Envíanos un mensaje
            </h3>

            <div class="form-group">

                <label>
                    Nombre completo
                </label>

                <input
                    type="text"
                    class="form-control"
                    placeholder="Tu nombre">

            </div>


            <div class="form-group">

                <label>
                    Correo electrónico
                </label>

                <input
                    type="email"
                    class="form-control"
                    placeholder="tu@email.com">

            </div>


            <div class="form-group">

                <label>
                    Mensaje
                </label>

                <textarea
                    rows="5"
                    class="form-control"
                    placeholder="¿En qué podemos ayudarte?">
                </textarea>

            </div>


            <button class="btn-enviar">

                Enviar mensaje

            </button>

        </div>

    </div>

</div>