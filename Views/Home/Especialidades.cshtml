@*
    Vista: Views/Home/Especialidades.cshtml
    Controlador: HomeController.Especialidades()  →  GET /Home/Especialidades
    Descripción: Muestra las especialidades médicas disponibles en la clínica
                 en una grilla de tarjetas: Cardiología, Neurología, Traumatología,
                 Oftalmología, Odontología y Pediatría.
    Modelo: ninguno (contenido estático).
    Acceso: público, no requiere sesión.
*@
@{
    ViewData["Title"] = "Especialidades";
}

<div class="pagina-contenido especialidades-page">

    <div class="esp-header">
        <span class="esp-badge">Especialidades médicas</span>
        <h2 class="esp-titulo">Nuestras Especialidades</h2>
        <p class="esp-subtitulo">Contamos con un equipo de profesionales altamente capacitados en diversas áreas médicas.</p>
    </div>

    <div class="especialidades-grid">

        <div class="especialidad-card">
            <div class="esp-icono color-rojo">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                </svg>
            </div>
            <div class="esp-body">
                <h3>Cardiología</h3>
                <p>Diagnóstico y tratamiento de enfermedades del corazón y sistema cardiovascular.</p>
            </div>
            <span class="esp-tag">Corazón</span>
        </div>

        <div class="especialidad-card">
            <div class="esp-icono color-violeta">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.46 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z" />
                    <path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.46 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z" />
                </svg>
            </div>
            <div class="esp-body">
                <h3>Neurología</h3>
                <p>Atención de trastornos del sistema nervioso central y periférico.</p>
            </div>
            <span class="esp-tag">Sistema nervioso</span>
        </div>

        <div class="especialidad-card">
            <div class="esp-icono color-naranja">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 20a6 6 0 0 0-12 0" />
                    <circle cx="12" cy="10" r="4" />
                    <path d="M6 20v-2a6 6 0 0 1 12 0v2" />
                    <line x1="12" y1="2" x2="12" y2="6" />
                    <line x1="12" y1="18" x2="12" y2="22" />
                </svg>
            </div>
            <div class="esp-body">
                <h3>Traumatología</h3>
                <p>Tratamiento de lesiones y enfermedades del sistema musculoesquelético.</p>
            </div>
            <span class="esp-tag">Huesos y músculos</span>
        </div>

        <div class="especialidad-card">
            <div class="esp-icono color-azul">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="2" />
                    <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z" />
                    <path d="M12 6a6 6 0 1 0 0 12 6 6 0 0 0 0-12z" />
                </svg>
            </div>
            <div class="esp-body">
                <h3>Oftalmología</h3>
                <p>Cuidado integral de la salud visual y tratamiento de enfermedades oculares.</p>
            </div>
            <span class="esp-tag">Salud visual</span>
        </div>

        <div class="especialidad-card">
            <div class="esp-icono color-cyan">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5.5c0-1.38 1.12-2.5 2.5-2.5S17 4.12 17 5.5c0 .93-.52 1.74-1.28 2.17" />
                    <path d="M15.72 7.67C17.08 8.44 18 9.86 18 11.5c0 2.49-2.01 4.5-4.5 4.5S9 13.99 9 11.5c0-1.64.92-3.06 2.28-3.83" />
                    <path d="M9 11.5C9 9.86 9.92 8.44 11.28 7.67" />
                    <path d="M7 19.5c.83-1.5 2.72-2.5 5-2.5s4.17 1 5 2.5" />
                </svg>
            </div>
            <div class="esp-body">
                <h3>Odontología</h3>
                <p>Atención dental completa para toda la familia.</p>
            </div>
            <span class="esp-tag">Salud dental</span>
        </div>

        <div class="especialidad-card">
            <div class="esp-icono color-verde">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 12h6" />
                    <path d="M12 9v6" />
                    <path d="M4 6V4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2" />
                    <rect width="20" height="14" x="2" y="6" rx="2" />
                </svg>
            </div>
            <div class="esp-body">
                <h3>Pediatría</h3>
                <p>Atención médica especializada para niños desde el nacimiento hasta la adolescencia.</p>
            </div>
            <span class="esp-tag">Niños y adolescentes</span>
        </div>

    </div>


</div>

<style>
    /* ── página ── */
    .especialidades-page {
        max-width: 960px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 3.5rem;
        font-family: inherit;
    }

    /* ── header ── */
    .esp-header {
        margin-bottom: 2.5rem;
    }

    .esp-badge {
        display: inline-block;
        background: #e6f4ee;
        color: #0f6e56;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        padding: 4px 12px;
        border-radius: 999px;
        margin-bottom: 0.75rem;
    }

    .esp-titulo {
        font-size: clamp(22px, 4vw, 30px);
        font-weight: 600;
        color: #1a2e23;
        margin: 0 0 0.5rem;
        line-height: 1.2;
    }

    .esp-subtitulo {
        font-size: 15px;
        color: #5a7a67;
        margin: 0;
        line-height: 1.6;
    }

    /* ── grid ── */
    .especialidades-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 16px;
        margin-bottom: 2.5rem;
    }

    /* ── card ── */
    .especialidad-card {
        background: #fff;
        border: 1px solid #ddeee6;
        border-radius: 14px;
        padding: 1.4rem 1.3rem 1.2rem;
        display: flex;
        flex-direction: column;
        gap: 0;
        transition: box-shadow 0.2s, transform 0.2s;
        position: relative;
    }

    .especialidad-card:hover {
        box-shadow: 0 6px 22px rgba(15, 110, 86, 0.1);
        transform: translateY(-3px);
    }

    /* ── ícono ── */
    .esp-icono {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        flex-shrink: 0;
    }

    .color-rojo    { background: #fde8e8; color: #c0392b; }
    .color-violeta { background: #ede8fb; color: #6c3fc7; }
    .color-naranja { background: #fef0e0; color: #b45309; }
    .color-azul    { background: #e6f0fb; color: #1e5fa6; }
    .color-cyan    { background: #e1f5fb; color: #0e7490; }
    .color-verde   { background: #e6f4ee; color: #0f6e56; }

    /* ── cuerpo ── */
    .esp-body h3 {
        font-size: 15px;
        font-weight: 600;
        color: #1a2e23;
        margin: 0 0 0.35rem;
    }

    .esp-body p {
        font-size: 13.5px;
        color: #5a7a67;
        line-height: 1.6;
        margin: 0 0 1rem;
    }

    /* ── tag ── */
    .esp-tag {
        display: inline-block;
        font-size: 11px;
        font-weight: 500;
        color: #3d6b52;
        background: #f0f9f4;
        border: 1px solid #c6e8d5;
        border-radius: 999px;
        padding: 3px 10px;
        margin-top: auto;
        align-self: flex-start;
    }

    /* ── cta ── */
    .esp-cta {
        background: #f0f9f4;
        border: 1px solid #c6e8d5;
        border-radius: 14px;
        padding: 1.5rem 1.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .esp-cta p {
        font-size: 14.5px;
        color: #1a2e23;
        font-weight: 500;
        margin: 0;
    }

    .btn-cta {
        display: inline-block;
        background: #0f6e56;
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        padding: 9px 22px;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.18s;
        white-space: nowrap;
    }

    .btn-cta:hover {
        background: #0a5240;
    }

    /* ── responsive ── */
    @@media (max-width: 520px) {
        .especialidades-grid {
            grid-template-columns: 1fr;
        }
        .esp-cta {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
