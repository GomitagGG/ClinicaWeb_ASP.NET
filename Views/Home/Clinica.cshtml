@*
    Vista: Views/Home/Clinica.cshtml
    Controlador: HomeController.Clinica()  →  GET /Home/Clinica
    Descripción: Página institucional "Sobre nosotros".
                 Muestra misión, visión, valores, ubicación y horarios de atención
                 de la Clínica Santa María.
    Modelo: ninguno (contenido estático).
    Acceso: público, no requiere sesión.
*@
@{
    ViewData["Title"] = "Nuestra Clínica";
}

<div class="pagina-contenido clinica-page">

    <div class="clinica-hero">
        <div class="clinica-hero-text">
            <span class="clinica-badge">Sobre nosotros</span>
            <h2 class="clinica-titulo">Clínica Santa María</h2>
            <p class="clinica-subtitulo">Nuestro compromiso es ofrecer un servicio humanizado, moderno y accesible para todos.</p>
        </div>
        <div class="clinica-hero-stat">
            <span class="stat-numero">20+</span>
            <span class="stat-label">años de experiencia</span>
        </div>
    </div>

    <div class="info-grid">

        <div class="info-card">
            <div class="info-card-icon icono-mision">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <circle cx="12" cy="12" r="6" />
                    <circle cx="12" cy="12" r="2" />
                </svg>
            </div>
            <h3>Misión</h3>
            <p>Brindar atención médica integral con calidad, calidez y tecnología de vanguardia, enfocada en el bienestar de nuestros pacientes.</p>
        </div>

        <div class="info-card">
            <div class="info-card-icon icono-vision">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                    <circle cx="12" cy="12" r="3" />
                </svg>
            </div>
            <h3>Visión</h3>
            <p>Ser el centro de salud de referencia en la región, reconocido por la excelencia en atención médica y satisfacción del paciente.</p>
        </div>

        <div class="info-card">
            <div class="info-card-icon icono-valores">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
            </div>
            <h3>Valores</h3>
            <ul class="valores-list">
                <li>Compromiso con el paciente</li>
                <li>Ética profesional</li>
                <li>Innovación constante</li>
                <li>Trabajo en equipo</li>
            </ul>
        </div>

        <div class="info-card info-card-ubicacion">
            <div class="info-card-icon icono-ubicacion">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                    <circle cx="12" cy="10" r="3" />
                </svg>
            </div>
            <h3>Ubicación</h3>
            <p class="ubicacion-direccion">Av. Salud 1234, Puerto Montt</p>
            <div class="horarios">
                <div class="horario-fila">
                    <span class="horario-dia">Lun – Vie</span>
                    <span class="horario-hora">8:00 – 20:00</span>
                </div>
                <div class="horario-fila">
                    <span class="horario-dia">Sábado</span>
                    <span class="horario-hora">9:00 – 14:00</span>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    /* ── página ── */
    .clinica-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 3rem;
        font-family: inherit;
    }

    /* ── hero ── */
    .clinica-hero {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid #e8f0ec;
    }

    .clinica-badge {
        display: inline-block;
        background: #e6f4ee;
        color: #0f6e56;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        padding: 4px 12px;
        border-radius: 999px;
        margin-bottom: 0.75rem;
    }

    .clinica-titulo {
        font-size: clamp(22px, 4vw, 30px);
        font-weight: 600;
        color: #1a2e23;
        margin: 0 0 0.5rem;
        line-height: 1.2;
    }

    .clinica-subtitulo {
        font-size: 15px;
        color: #5a7a67;
        margin: 0;
        max-width: 480px;
        line-height: 1.6;
    }

    .clinica-hero-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: #e6f4ee;
        border-radius: 14px;
        padding: 1rem 1.5rem;
        flex-shrink: 0;
    }

    .stat-numero {
        font-size: 32px;
        font-weight: 700;
        color: #0f6e56;
        line-height: 1;
    }

    .stat-label {
        font-size: 12px;
        color: #2e7d5a;
        text-align: center;
        margin-top: 4px;
    }

    /* ── grid ── */
    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }

    /* ── card base ── */
    .info-card {
        background: #fff;
        border: 1px solid #ddeee6;
        border-radius: 14px;
        padding: 1.4rem 1.3rem;
        transition: box-shadow 0.2s, transform 0.2s;
    }

    .info-card:hover {
        box-shadow: 0 6px 20px rgba(15, 110, 86, 0.09);
        transform: translateY(-2px);
    }

    .info-card-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }

    .icono-mision  { background: #fef3e2; color: #b45309; }
    .icono-vision  { background: #e6f0fb; color: #1e5fa6; }
    .icono-valores { background: #fde8f4; color: #9d2d72; }
    .icono-ubicacion { background: #e6f4ee; color: #0f6e56; }

    .info-card h3 {
        font-size: 15px;
        font-weight: 600;
        color: #1a2e23;
        margin: 0 0 0.5rem;
    }

    .info-card p {
        font-size: 13.5px;
        color: #5a7a67;
        line-height: 1.65;
        margin: 0;
    }

    /* ── valores list ── */
    .valores-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .valores-list li {
        font-size: 13.5px;
        color: #5a7a67;
        padding-left: 1.1rem;
        position: relative;
        line-height: 1.5;
    }

    .valores-list li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 8px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #0f6e56;
    }

    /* ── ubicación ── */
    .ubicacion-direccion {
        font-size: 13.5px;
        color: #1a2e23;
        font-weight: 500;
        margin: 0 0 0.75rem;
    }

    .horarios {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .horario-fila {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
        background: #f3faf6;
        border-radius: 7px;
        padding: 5px 10px;
    }

    .horario-dia  { color: #3d6b52; font-weight: 500; }
    .horario-hora { color: #0f6e56; font-weight: 600; }

    /* ── responsive ── */
    @@media (max-width: 600px) {
        .clinica-hero {
            flex-direction: column;
            align-items: flex-start;
        }
        .clinica-hero-stat {
            flex-direction: row;
            gap: 0.75rem;
            align-items: baseline;
            padding: 0.75rem 1.25rem;
        }
    }
</style>
